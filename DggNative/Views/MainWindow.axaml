<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DggNative.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DggNative.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="DggNative">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid Loaded="Control_OnLoaded" RowDefinitions="*,Auto">
        <Grid Grid.Row="0">
            <ScrollViewer ScrollChanged="ScrollViewer_OnScrollChanged" Name="MessageScrollViewer">
                <ItemsControl ItemsSource="{Binding MessageList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Padding="1.4 8.4 1.4 4.2" TextWrapping="Wrap">
                                <TextBlock.Background>
                                    <MultiBinding Converter="{StaticResource MessageBackgroundConverter}">
                                        <Binding Path="Data" />
                                        <Binding Path="$parent[Window].DataContext.LocalUser.Nick" FallbackValue="{x:Null}" TargetNullValue="{x:Null}" />
                                        <Binding Path="User.Nick" />
                                        <Binding Path="$parent[Window].ActualThemeVariant" />
                                    </MultiBinding>
                                </TextBlock.Background>
                                <Run
                                    Text="{Binding User.Nick}"
                                    FontWeight="600"
                                    ><Run.Foreground>
                                        <MultiBinding Converter="{StaticResource SubscriptionToColorConverter}">
                                            <Binding Path="User.Subscription" />
                                            <Binding Path="$parent[Window].ActualThemeVariant" />
                                        </MultiBinding>
                                    </Run.Foreground>
                                </Run><Run Text=":" />
                                <Run Text="{Binding Data}"></Run>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Name="MoreMessagesButton"
                    Content="More messages below"
                    IsVisible="False"
                    Click="MoreMessagesButton_OnClick"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,12"
                    Padding="12,6"
                    CornerRadius="16"
                    Opacity="0.95"
                    ZIndex="1" />
        </Grid>

        <!-- Connecting overlay -->
        <Border Grid.Row="0" Background="{DynamicResource ChatOverlayBackgroundBrush}"
                IsVisible="{Binding !IsConnected}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="{Binding ConnectionStatusText}"
                           FontSize="16"
                           Foreground="{DynamicResource ChatOverlayForegroundBrush}" />
            </StackPanel>
        </Border>

        <!-- Input area / Login prompt -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource ChatInputBorderBrush}"
                BorderThickness="0 1 0 0"
                Padding="8">
            <Panel>
                <!-- Login button when not authenticated -->
                <Button Name="LoginButton"
                        Content="Login to chat"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Click="LoginButton_OnClick"
                        IsVisible="{Binding !IsLoggedIn}" />

                <!-- Message input when authenticated -->
                <Grid ColumnDefinitions="*,Auto"
                      IsVisible="{Binding IsLoggedIn}">
                    <TextBox Grid.Column="0"
                             Name="MessageInput"
                             KeyDown="MessageInput_OnKeyDown"
                             Watermark="{Binding LocalUser.Nick, StringFormat='Write something {0}...', FallbackValue='Write something...'}" />
                    <Button Grid.Column="1"
                            Content="Logout"
                            Click="LogoutButton_OnClick"
                            Margin="8,0,0,0"
                            VerticalAlignment="Stretch" />
                </Grid>
            </Panel>
        </Border>
    </Grid>
</Window>
